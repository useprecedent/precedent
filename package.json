{
  "name": "@useprecedent/precedent",
  "version": "0.1.4",
  "description": "Compile Cursor AGENTS.md, CLAUDE.md, and .cursor/rules; report always-on conflicts. CLI, GitHub Action, and Cursor skill.",
  "author": "Precedent",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/useprecedent/precedent#readme",
  "bugs": {
    "url": "https://github.com/useprecedent/precedent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useprecedent/precedent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "precedent": "bin/precedent.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    "SKILL.md",
    "LICENSE",
    "README.md",
    "action.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cursor",
    "agents.md",
    "claude.md",
    "rules",
    "policy",
    "github-action"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "precedent": "node --experimental-strip-types src/cli.ts",
    "smoke:packaged-cli": "node scripts/smoke-packaged-cli.mjs",
    "test": "python3 scripts/test_compile_instructions.py && node --experimental-strip-types --test test/*.test.ts",
    "compile": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
